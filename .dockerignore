# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# build.sh produces its outputs under /mayhem (and mayhem-build/, mayhem-tests/) at build time.
mayhem-build/
mayhem-tests/
.libs/
*.o
*.a
*.lo
*.la
*.so
*.dylib
**/__pycache__/

# autoconf-generated cruft (regenerated by build.sh's autogen.sh)
/configure
/config.h
/config.log
/config.status
/aclocal.m4
/autom4te.cache/
/src/config/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
